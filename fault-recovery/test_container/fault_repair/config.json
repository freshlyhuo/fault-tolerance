{
  "ociVersion": "1.0.0",
  "root": {
    "path": "rootfs",
    "readonly": false
  },
  "mounts": [
    {
      "destination": "/etc/lic",
      "source": "/etc/lic",
      "options": [
        "ro"
      ]
    },
    {
      "destination": "/bin/uname",
      "source": "/bin/uname",
      "options": [
        "rx"
      ]
    },
    {
      "destination": "/bin/tar",
      "source": "/bin/tar",
      "options": [
        "rx"
      ]
    },
    {
      "destination": "/lib",
      "source": "/lib",
      "options": [
        "rx"
      ]
    },
    {
      "destination": "/usr",
      "source": "/usr",
      "options": [
        "rx"
      ]
    }
  ],
  "process": {
    "user": {
      "uid": 0,
      "gid": 0
    },
    "args": [
      "python3",
      "/apps/main.py"
    ],
    "env": [
      "LD_LIBRARY_PATH=/qt/lib:/usr/lib:/lib:/usr/local/lib:/lib/jsre:/lib/vsoa",
      "PATH=/usr/bin:/bin:/usr/pkg/sbin:/sbin:/usr/local/bin",
      "RS422_PORT=/dev/ttyS2",
      "VSOA_ADDR=0.0.0.0:4551",
      "VSOA_NAME=faultcode-vsoa-rpc",
      "VSOA_PASSWORD=",
      "PYTHONUNBUFFERED=1"
    ],
    "cwd": "/"
  },
  "hostname": "sylixos_ecs",
  "platform": {
    "os": "sylixos",
    "arch": "arm64"
  },
  "sylixos": {
    "devices": [
      {
        "path": "/dev/fb0",
        "access": "rw"
      },
      {
        "path": "/dev/input/xmse",
        "access": "rw"
      },
      {
        "path": "/dev/input/xkbd",
        "access": "rw"
      },
      {
        "path": "/dev/net/vnd",
        "access": "rw"
      },
      {
        "path": "/dev/ttyS2",
        "access": "rw"
      }
    ],
    "resources": {
      "affinity": [],
      "cpu": {
        "highestPrio": 150,
        "lowestPrio": 250,
        "defaultPrio": 200
      },
      "itimer": {
        "defaultPrio": 200
      },
      "memory": {
        "kheapLimit": 2147483648,
        "memoryLimitMB": 4096
      },
      "kernelObject": {
        "threadLimit": 4096,
        "threadPoolLimit": 32,
        "eventLimit": 32768,
        "eventSetLimit": 500,
        "partitionLimit": 6000,
        "regionLimit": 256,
        "msgQueueLimit": 8192,
        "timerLimit": 64,
        "rmsLimit": 32,
        "threadVarLimit": 16,
        "posixMqueueLimit": 300,
        "dlopenLibraryLimit": 50,
        "xsiipcLimit": 100,
        "socketLimit": 1024,
        "srtpLimit": 30,
        "deviceLimit": 60
      },
      "disk": {
        "limitMB": 2048
      }
    },
    "commands": [
      "exec",
      "top",
      "cpuus",
      "vi",
      "cat",
      "touch",
      "ps",
      "ts",
      "tp",
      "ss",
      "ints",
      "ls",
      "cd",
      "pwd",
      "modules",
      "varload",
      "varsave",
      "shstack",
      "srtp",
      "shfile",
      "help",
      "debug",
      "shell",
      "ll",
      "sync",
      "ln",
      "kill",
      "free",
      "ifconfig",
      "mems",
      "env",
      "rm",
      "exit",
      "mkdir",
      "echo",
      "mv",
      "python3",
      "/usr/bin/python3"
    ],
    "network": {
      "telnetdEnable": true,
      "ftpdEnable": true,
      "sshdEnable": false
    }
  }
}